      "motion": "slow_pan",
      "overlay_text": "Pisco Formation, Peru",
      "narration": "The first Livyatan fossils were found in the Pisco Formation of Peru, along the Pacific coast of South America."
    },
    {
      "shot_id": "s05_02",
      "scene": 5,
      "scene_title": "Where It Lived",
      "start_sec": 157.612,
