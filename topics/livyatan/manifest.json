        "duration_sec": 12.042,
        "words": []
      },
      "motion": "none",
      "overlay_text": "13-17 m (43-56 ft)",
      "narration": "Let's talk size, because this is where it gets hard to picture. Estimates for Livyatan put its length somewhere between about 13 and 17 meters, roughly 43 to 56 feet."
    },
    {
      "shot_id": "s03_02",
      "scene": 3,
      "scene_title": "Size",
      "start_sec": 80.948,
      "end_sec": 94.699,
      "duration_sec": 13.751,
