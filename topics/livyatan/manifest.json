        "status": "ready",
        "duration_sec": 9.796,
        "words": []
      },
      "motion": "slow_push_in",
      "overlay_text": "",
      "narration": "Livyatan had teeth that could pierce, hold, and possibly tear. This was a hunter that bit its prey, not one that strained seawater for snacks."
    },
