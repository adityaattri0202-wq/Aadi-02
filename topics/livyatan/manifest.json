      },
      "motion": "parallax",
      "overlay_text": "",
      "narration": "Now imagine you're swimming there, and something enormous passes beneath you. Not a shark. Not a whale you'd recognize. Something built like a sperm whale, but bigger, and with a mouth that looks like it was designed to end arguments quickly."
    },
    {
      "shot_id": "s01_03",
      "scene": 1,
      "scene_title": "Cold Open",
      "start_sec": 24.054,
      "end_sec": 31.248,
