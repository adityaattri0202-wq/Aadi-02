        "status": "ready"
      },
      "clip": null,
      "audio": {
        "path": "voiceover/s02_06.mp3",
        "status": "ready",
        "duration_sec": 9.064,
        "words": []
      },
      "motion": "none",
      "overlay_text": "$50,000 REWARD",
      "narration": "A decade earlier, in 1873, the famous showman P.T. Barnum had even announced a reward of $50,000 for anyone who could capture the creature."
    },
    {
      "shot_id": "s02_07",
      "scene": 2,
      "scene_title": "Champ",
      "start_sec": 85.897,
      "end_sec": 94.678,
