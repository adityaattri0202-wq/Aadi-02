        "status": "ready"
      },
      "clip": null,
      "audio": {
        "path": "voiceover/s03_03.mp3",
        "status": "ready",
        "duration_sec": 9.744,
        "words": []
      },
      "motion": "none",
      "overlay_text": "",
      "narration": "The creature continues passing by, but its tail is nowhere in sight. This sounds like something from a science fiction movie. But the recording connected to this mystery is completely real."
    },
    {
      "shot_id": "s03_04",
      "scene": 3,
      "scene_title": "The Julia Beast",
      "start_sec": 219.554,
      "end_sec": 229.85,
