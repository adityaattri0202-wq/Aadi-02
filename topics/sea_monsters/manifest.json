        "status": "ready",
        "duration_sec": 7.497,
        "words": []
      },
      "motion": "none",
      "overlay_text": "2. THE JULIA BEAST",
      "narration": "Number two: the Julia Beast. Imagine looking down into the Antarctic Ocean and seeing something enormous moving beneath the darkness."
    },
    {
      "shot_id": "s03_02",
      "scene": 3,
      "scene_title": "The Julia Beast",
      "start_sec": 197.682,
      "end_sec": 209.31,
      "duration_sec": 11.628,
      "image": {
        "path": "images/s03_02.png",
        "status": "ready"
      },
      "clip": {
