        "status": "ready"
      },
      "clip": null,
      "audio": {
        "path": "voiceover/s02_04.mp3",
        "status": "ready",
        "duration_sec": 13.322,
        "words": []
      },
      "motion": "none",
      "overlay_text": "",
      "narration": "Mansi quickly pulled out her Kodak Instamatic camera and managed to capture a single photograph before her family left the area. That photograph would eventually become the most famous piece of evidence associated with a mysterious creature known as Champ."
    },
    {
      "shot_id": "s02_05",
      "scene": 2,
      "scene_title": "Champ",
      "start_sec": 63.529,
      "end_sec": 76.333,
      "duration_sec": 12.804,
      "image": {
        "path": "images/s02_05.png",
        "status": "ready"
      },
      "clip": null,
      "audio": {
        "path": "voiceover/s02_05.mp3",
        "status": "ready",
        "duration_sec": 12.304,
        "words": []
      },
      "motion": "none",
      "overlay_text": "1883",
      "narration": "But reports of this animal existed long before that photograph. Back in 1883, Clinton County Sheriff Nathan Mooney claimed to have witnessed a massive water serpent measuring somewhere between 25 and 35 feet."
    },
    {
      "shot_id": "s02_06",
      "scene": 2,
      "scene_title": "Champ",
      "start_sec": 76.333,
      "end_sec": 85.897,
      "duration_sec": 9.564,
      "image": {
