      },
      "audio": {
        "path": "voiceover/s03_02.mp3",
        "status": "ready",
        "duration_sec": 11.128,
        "words": []
      },
      "motion": "none",
      "overlay_text": "",
      "narration": "A gigantic head emerges first, followed by three pairs of eyes that appear to be looking in different directions. Its body is covered in strange dark markings, almost as if they're glowing against the black water."
    },
    {
      "shot_id": "s03_03",
      "scene": 3,
      "scene_title": "The Julia Beast",
      "start_sec": 209.31,
      "end_sec": 219.554,
