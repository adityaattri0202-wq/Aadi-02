        "status": "ready",
        "duration_sec": 8.281,
        "words": []
      },
      "motion": "none",
      "overlay_text": "120 MILES LONG",
      "narration": "And the lake itself makes the mystery even more interesting. Lake Champlain stretches approximately 120 miles and reaches depths of nearly 400 feet."
    },
    {
      "shot_id": "s02_08",
      "scene": 2,
      "scene_title": "Champ",
      "start_sec": 94.678,
      "end_sec": 108.709,
